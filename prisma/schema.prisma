// ClientFlow — Client Management & AI Automation Platform
//
// CHANGES FROM THE ORIGINAL SCHEMA (all deliberate, see notes):
//  1. provider "sqlite" -> "postgresql"  (project requirement + Vercel)
//  2. status/role/priority String fields -> real PostgreSQL enums.
//     SQLite cannot do enums, so they were plain strings with a comment.
//     Postgres enforces valid values at the DATABASE level, so a typo like
//     "ACTVE" becomes impossible instead of silently corrupting data.
//  3. Added fields required by the spec docs but missing from the model.
//  4. Added AutomationRun (docs/03 "automation_runs") — the existing
//     N8nAutomation model stores workflow CONFIG, not execution HISTORY.
//  5. Added @@index on frequently filtered columns (docs/03 requirement).
//
// No models or fields were removed.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  PROJECT_MANAGER
  TEAM_MEMBER
  CLIENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

// Lifecycle from docs/08: New -> Contacted -> Qualified -> Proposal -> Won/Lost
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFYING
  QUALIFIED
  PROPOSAL
  WON
  LOST
  DISQUALIFIED
  CONVERTED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// Lifecycle from docs/09: Planning -> Active -> On Hold -> Completed/Cancelled
enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

// Lifecycle from docs/10: Todo -> In Progress -> Review -> Completed
enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ALERT
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(CLIENT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  clientProfile   Client?
  assignedTasks   Task[]         @relation("AssignedUserTasks")
  createdTasks    Task[]         @relation("CreatedUserTasks")
  assignedLeads   Lead[]         @relation("AssignedUserLeads")
  managedProjects Project[]      @relation("ProjectManager")
  notifications   Notification[]
  auditLogs       AuditLog[]

  @@index([role])
  @@index([status])
}

model Lead {
  id      String  @id @default(uuid())
  name    String
  email   String
  company String?
  phone   String?
  source  String  @default("Website Intake")
  message String

  // Added per docs/05 (lead form collects service + budget range).
  service     String?
  budgetRange String?

  status LeadStatus @default(NEW)

  // Staff member responsible for this lead (docs/08 "assignment").
  assignedToId String?
  assignedTo   User?   @relation("AssignedUserLeads", fields: [assignedToId], references: [id], onDelete: SetNull)

  // --- AI qualification (docs/12) ---
  aiQualified     Boolean @default(false)
  aiScore         Int     @default(0)
  aiSummary       String?
  aiSuggestedRole String?

  // --- n8n metadata (docs/11) ---
  n8nSyncedAt    DateTime?
  n8nExecutionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  convertedClient Client?

  // Indexed because the admin lead list filters on these constantly.
  @@index([status])
  @@index([email])
  @@index([assignedToId])
  @@index([createdAt])
}

model Client {
  id          String       @id @default(uuid())
  companyName String
  industry    String?
  status      ClientStatus @default(ACTIVE)

  // Added per docs/03 (clients table has phone, email, address).
  phone   String?
  email   String?
  address String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  leadId String? @unique
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
}

model Project {
  id          String        @id @default(uuid())
  title       String
  description String?
  status      ProjectStatus @default(PLANNING)
  priority    Priority      @default(MEDIUM)
  progress    Int           @default(0) // 0-100
  budget      Float         @default(0.0)
  startDate   DateTime?
  deadline    DateTime?

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Project manager responsible (docs/09 "manager" field).
  managerId String?
  manager   User?   @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([managerId])
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?

  // Added per docs/03 + docs/10 (needed for completion reporting).
  completedAt DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("AssignedUserTasks", fields: [assigneeId], references: [id], onDelete: SetNull)

  creatorId String?
  creator   User?   @relation("CreatedUserTasks", fields: [creatorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
}

model Notification {
  id      String           @id @default(uuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title   String
  message String
  isRead  Boolean          @default(false)
  type    NotificationType @default(INFO)

  // Added per docs/13 ("related entity") so a notification can deep-link.
  entityType String?
  entityId   String?

  createdAt DateTime @default(now())

  // Composite index: "unread notifications for this user" is the hot query.
  @@index([userId, isRead])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String // e.g. "USER_LOGIN", "LEAD_QUALIFIED"
  entity    String // e.g. "Lead", "Project", "Auth"
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

/// Stores the CONFIGURATION of an n8n workflow (which URL to call for an event).
model N8nAutomation {
  id         String    @id @default(uuid())
  name       String
  eventType  String    @unique // e.g. "LEAD_CREATED"
  webhookUrl String
  isActive   Boolean   @default(true)
  runCount   Int       @default(0)
  lastRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  runs AutomationRun[]
}

/// Stores the HISTORY of each individual automation execution.
/// Required by docs/03 (automation_runs) and docs/11 (execution logging,
/// retries, idempotency, failure alerts).
model AutomationRun {
  id           String              @id @default(uuid())
  workflowName String
  triggerType  String // e.g. "LEAD_CREATED"
  entityType   String? // e.g. "Lead"
  entityId     String?
  status       AutomationRunStatus @default(PENDING)
  executionId  String? // id returned by n8n
  errorMessage String?

  // Prevents the same event firing twice (docs/11 "idempotency keys").
  idempotencyKey String? @unique

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  automationId String?
  automation   N8nAutomation? @relation(fields: [automationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([entityType, entityId])
  @@index([startedAt])
}
