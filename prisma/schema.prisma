// ClientFlow — Client Management & AI Automation Platform
//
// Core database layer. Every model below maps to one of the 8 required
// entities: User, Client, Lead, Project, Task, Notification, AutomationRun,
// AuditLog.
//
// DESIGN DECISIONS beyond the literal spec (each is a correctness fix, not
// scope creep):
//
//  1. Client.userId is OPTIONAL, not required.
//     A client company can exist before anyone creates them a portal login
//     (e.g. admin enters a new client manually). "belongs to a user where
//     applicable" in the spec means exactly this — make it optional.
//
//  2. User -> Client relation uses onDelete: SetNull, not Cascade.
//     The previous schema cascaded: delete a User -> delete their Client ->
//     delete all their Projects -> delete all Tasks. One accidental user
//     deletion would silently destroy a client's entire project history.
//     SetNull detaches the portal login but keeps the business record intact.
//
//  3. Lead has TWO relations to Client, not one:
//       - clientId          : an EXISTING client this lead is tied to
//                              (repeat/upsell business). Many-to-one — a
//                              client can have many historical leads.
//       - (Client.convertedFromLeadId) : the ONE lead that originated this
//                              client via conversion. One-to-one.
//     This satisfies both "Lead can optionally convert into a client" AND
//     "Client can have multiple leads historically" without conflating them.
//
//  4. LeadSource is a real enum, not a free-text string.
//     The spec says "stores source ... information" and asks for "proper
//     enum values" throughout — a free-text source field lets "website",
//     "Website", "web site" all exist as different values, which breaks
//     reporting by source (a named requirement of this platform).
//
// N8nAutomation (workflow configuration) is intentionally NOT part of this
// schema — it belongs to the automation module, not the core data layer, and
// wasn't in the required-entities list.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  PROJECT_MANAGER
  TEAM_MEMBER
  CLIENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum LeadSource {
  WEBSITE
  REFERRAL
  API
  MANUAL
  N8N_WEBHOOK
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ALERT
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(CLIENT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // one client profile "where applicable" — not every user is a client
  clientProfile Client?

  // leads this user manages
  assignedLeads Lead[] @relation("AssignedUserLeads")

  // projects this user manages as project manager
  managedProjects Project[] @relation("ProjectManager")

  // tasks assigned to this user
  assignedTasks Task[] @relation("AssignedUserTasks")
  createdTasks  Task[] @relation("CreatedUserTasks")

  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([role])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Client
// ---------------------------------------------------------------------------

model Client {
  id          String       @id @default(uuid())
  companyName String
  industry    String?
  status      ClientStatus @default(ACTIVE)
  phone       String?
  email       String?
  address     String?

  // Optional: a client can exist before they have a portal login.
  // onDelete: SetNull — deleting the login must never delete the business
  // record or cascade into its projects/tasks.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // The single lead that originated this client via conversion (if any).
  convertedFromLeadId String? @unique
  convertedFromLead   Lead?   @relation("LeadConversion", fields: [convertedFromLeadId], references: [id], onDelete: SetNull)

  // All leads historically tied to this client (repeat business), including
  // but not limited to the one that originated it.
  leads Lead[] @relation("ClientLeads")

  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
}

// ---------------------------------------------------------------------------
// Lead
// ---------------------------------------------------------------------------

model Lead {
  id      String     @id @default(uuid())
  name    String
  email   String
  company String?
  phone   String?
  source  LeadSource @default(WEBSITE)
  message String

  service     String?
  budgetRange String?

  status LeadStatus @default(NEW)

  // Staff member responsible for working this lead.
  assignedToId String?
  assignedTo   User?   @relation("AssignedUserLeads", fields: [assignedToId], references: [id], onDelete: SetNull)

  // An existing client this lead is associated with (repeat business).
  // Distinct from the conversion relation below — see schema header.
  clientId String?
  client   Client? @relation("ClientLeads", fields: [clientId], references: [id], onDelete: SetNull)

  // --- AI qualification ---
  qualificationScore   Int? // 0-100, null = not yet AI-processed
  qualificationSummary String? // one-paragraph human-readable summary
  qualificationReason  String? // why the AI reached this score/summary
  aiProcessedAt        DateTime?

  // --- n8n automation metadata ---
  n8nSyncedAt    DateTime?
  n8nExecutionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Reverse side of Client.convertedFromLeadId (one-to-one).
  convertedClient Client? @relation("LeadConversion")

  // A lead can optionally result directly in a project.
  convertedProject Project? @relation("LeadProject")

  @@index([status])
  @@index([email])
  @@index([assignedToId])
  @@index([clientId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Project
// ---------------------------------------------------------------------------

model Project {
  id          String        @id @default(uuid())
  title       String
  description String?
  status      ProjectStatus @default(PLANNING)
  priority    Priority      @default(MEDIUM)
  progress    Int           @default(0) // 0-100
  budget      Float         @default(0.0)
  startDate   DateTime?
  deadline    DateTime?

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Assigned project manager.
  managerId String?
  manager   User?   @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  // Optional: the lead that directly generated this project.
  originatingLeadId String? @unique
  originatingLead   Lead?   @relation("LeadProject", fields: [originatingLeadId], references: [id], onDelete: SetNull)

  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([managerId])
}

// ---------------------------------------------------------------------------
// Task
// ---------------------------------------------------------------------------

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Team member this task is assigned to.
  assigneeId String?
  assignee   User?   @relation("AssignedUserTasks", fields: [assigneeId], references: [id], onDelete: SetNull)

  creatorId String?
  creator   User?   @relation("CreatedUserTasks", fields: [creatorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
}

// ---------------------------------------------------------------------------
// Notification
// ---------------------------------------------------------------------------

model Notification {
  id      String           @id @default(uuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title   String
  message String
  isRead  Boolean          @default(false)
  type    NotificationType @default(INFO)

  // Optional deep-link to the entity this notification is about.
  entityType String?
  entityId   String?

  createdAt DateTime @default(now())

  // "unread notifications for this user" is the hot query — composite index.
  @@index([userId, isRead])
}

// ---------------------------------------------------------------------------
// AutomationRun — records a single n8n workflow execution
// ---------------------------------------------------------------------------

model AutomationRun {
  id           String              @id @default(uuid())
  workflowName String
  entityType   String? // e.g. "Lead", "Project"
  entityId     String?
  executionId  String? // id returned by n8n
  status       AutomationRunStatus @default(PENDING)
  errorMessage String?

  // Prevents the same event firing the same workflow twice.
  idempotencyKey String? @unique

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status])
  @@index([entityType, entityId])
  @@index([startedAt])
}

// ---------------------------------------------------------------------------
// AuditLog — records important system actions
// ---------------------------------------------------------------------------

model AuditLog {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action   String // e.g. "USER_LOGIN", "LEAD_QUALIFIED"
  entity   String // e.g. "Lead", "Project", "Auth"
  entityId String?

  // Structured metadata (e.g. { "oldStatus": "NEW", "newStatus": "QUALIFIED" }).
  // Json, not free text, so it can be queried and stays machine-readable.
  metadata Json?

  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}
