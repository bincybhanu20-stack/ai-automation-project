# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
#
# `.env` is git-ignored and must NEVER be committed.
# `.env.example` IS committed — so only put placeholders here, never secrets.
# ---------------------------------------------------------------------------

# --- Database (required) ---
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/clientflow?schema=public"

# --- Authentication (required) ---
# Signs the session cookie. MUST be at least 32 characters.
# Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-string-at-least-32-characters"

# --- n8n automation (optional until Phase 8) ---
# Outbound: this app -> n8n. N8N_WEBHOOK_URL must be the exact production
# webhook URL for the target n8n workflow (e.g. WF-001's
# ".../webhook/lead-qualification"). Sent as header X-N8N-Secret on every
# triggerN8nWebhook() call (src/lib/n8n.ts) — this must match the header
# name configured on that webhook trigger node's Header Auth credential in
# n8n, or every request is rejected before n8n logs an execution.
N8N_WEBHOOK_URL="http://localhost:5678/webhook"
N8N_WEBHOOK_SECRET=""
# Optional: WF-003's own webhook URL. TASK_CREATED is routed here instead of
# N8N_WEBHOOK_URL (each n8n workflow has a distinct URL, not a shared one) —
# see the `url` override in src/lib/n8n.ts. Unset means TASK_CREATED is
# simply not attempted, same as any other unconfigured webhook.
N8N_TASK_WEBHOOK_URL=""
# Inbound: n8n -> this app (e.g. GET /api/n8n/projects/:id/context). The SAME
# value as above — n8n's HTTP Request node must send it back as header
# X-N8N-Secret. See src/lib/n8n-auth.ts and docs/n8n-integration.md.

# --- Scheduled automation (Vercel Cron) ---
# Protects GET /api/cron/automation-scan (overdue tasks, approaching
# deadlines). Vercel automatically sends this as
# `Authorization: Bearer <CRON_SECRET>` on cron-triggered requests when a
# project env var with EXACTLY this name is set — no other wiring needed.
# See src/lib/n8n-auth.ts verifyCronSecret() and vercel.json.
CRON_SECRET=""

# --- AI provider (optional) ---
# Leave OPENAI_API_KEY empty to use the built-in rules-based scoring engine.
# The app works fully without it.
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# --- App ---
# Safe to be public — it is only a URL, not a secret.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
